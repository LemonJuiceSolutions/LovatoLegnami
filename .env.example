# Variabili d'ambiente (validate da src/server/env.ts).
# In sviluppo e nei test nessuna è obbligatoria: senza DATABASE_URL si usa PGlite su
# .data/pglite/, le email sono stampate in console e le foto salvate in .data/uploads/.
# [PROD] = obbligatoria con NODE_ENV=production; [opz.] = facoltativa ovunque.

# --- Sito e sicurezza -------------------------------------------------------
# [PROD] URL pubblico del sito, senza barra finale (link nelle email, sitemap, OG).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# [PROD] Segreto per firmare le sessioni di Auth.js, almeno 32 caratteri:
#        openssl rand -base64 32
AUTH_SECRET=

# --- Database ---------------------------------------------------------------
# [PROD] Postgres gestito (es. Neon via Vercel Marketplace), forma postgres://…
#        Assente in sviluppo ⇒ PGlite in-process.
DATABASE_URL=

# --- Email ------------------------------------------------------------------
# [opz.] Chiave API di Resend; assente ⇒ email stampate in console (in produzione
#        con un avviso all'avvio).
RESEND_API_KEY=
# [PROD] Mittente delle email (dominio verificato su Resend), es.
#        "Lovato Legnami <preventivi@lovatolegnami.it>"
EMAIL_FROM=
# [PROD] Casella dell'ufficio che riceve le notifiche delle richieste.
OFFICE_EMAIL=

# --- Foto dei clienti --------------------------------------------------------
# [opz.] Token di Vercel Blob; assente ⇒ foto salvate su disco locale.
BLOB_READ_WRITE_TOKEN=

# --- Seed e analytics -------------------------------------------------------
# [opz.] Email dell'utente admin creato da `npm run db:seed`.
ADMIN_EMAIL=
# [opz.] 1 = monta Vercel Analytics (senza cookie); 0 o assente = spento.
NEXT_PUBLIC_ANALYTICS=0

# --- Assistente AI (esistente) ----------------------------------------------
# Opzionali: le API key dei provider si impostano da /ai (salvate nel browser).
# Ollama locale
OLLAMA_API_BASE=http://localhost:11434
# Percorso Claude CLI (provider "claude-cli")
CLAUDE_PATH=claude
# Fallback server-side per la trascrizione vocale
GROQ_API_KEY=
