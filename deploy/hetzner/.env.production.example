# Variabili di produzione dello stack Docker (deploy/hetzner/docker-compose.yml).
# Non compilare a mano: sul server `deploy/hetzner/gen-env.sh` crea `.env.production`
# (permessi 600) con segreti casuali. Validate all'avvio da src/server/env.ts.
# Lo stesso file serve a Compose sia come `env_file` del container sia come `--env-file`
# per le variabili di interpolazione (POSTGRES_*, NEXT_PUBLIC_SITE_URL come argomento di build).

# --- Sito e sicurezza -------------------------------------------------------
# [PROD] URL pubblico principale, senza barra finale (link nelle email, sitemap, OG).
NEXT_PUBLIC_SITE_URL=https://lovato.91-98-45-4.sslip.io
# [PROD] Segreto di Auth.js, almeno 32 caratteri (gen-env.sh: openssl rand -base64 48).
AUTH_SECRET=sostituire-con-openssl-rand-base64-48
# Auth.js dietro Caddy: fidarsi di X-Forwarded-Host/Proto, così l'accesso funziona su
# entrambi gli host (lovato.… e configuratore.…). NON impostare AUTH_URL.
AUTH_TRUST_HOST=true

# --- Database (container lovato-db, rete interna) ---------------------------
POSTGRES_USER=lovato
POSTGRES_DB=lovato
# Esadecimale: nessun carattere da codificare nell'URL qui sotto.
POSTGRES_PASSWORD=sostituire-con-openssl-rand-hex-24
# [PROD] Stessa password di POSTGRES_PASSWORD; host = nome del servizio Compose.
DATABASE_URL=postgres://lovato:sostituire-con-openssl-rand-hex-24@lovato-db:5432/lovato

# --- Email ------------------------------------------------------------------
# Vuota: niente Resend, le email sono stampate nel log del container (solo destinatario e
# oggetto in produzione). Per entrare nel back-office: npm run admin:link (docs/deploy.md).
RESEND_API_KEY=
# [PROD] Mittente e casella dell'ufficio (richieste per la validazione anche senza Resend).
EMAIL_FROM="Lovato Legnami <preventivi@lovato.91-98-45-4.sslip.io>"
OFFICE_EMAIL=ufficio@lovato.91-98-45-4.sslip.io

# --- Foto dei clienti -------------------------------------------------------
# Vuota: foto su disco, nel volume Docker `lovato-uploads` (/app/.data/uploads).
BLOB_READ_WRITE_TOKEN=

# --- Seed, analytics, limiti -----------------------------------------------
# Admin creato da `npm run db:seed` (idempotente).
ADMIN_EMAIL=tonslemonjuice@gmail.com
# 0 = Vercel Analytics spento (fuori da Vercel non serve).
NEXT_PUBLIC_ANALYTICS=0
# Facoltativi, forma N/secondi (default 5/600 e 60/60). Un solo container: limiti esatti.
RATE_LIMIT_SUBMIT=
RATE_LIMIT_ESTIMATE=
